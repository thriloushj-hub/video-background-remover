# --- Python ---
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.env

# --- Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Model weights / checkpoints ---
# Directories the setup instructions clone or download into.
checkpoints/
pretrained_models/
third_party/
# Weight files by extension, wherever they land.
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.tflite
*.pkl

# --- Video / media inputs and outputs ---
clips/
output vids/
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.gif
*.wav
*.mp3

# --- Generated outputs ---
# Pipeline output at the repo root only. NOTE: intentionally anchored with a
# leading slash so it does NOT swallow bench/results/*.json, which are the
# small frozen baseline metrics that docs/BASELINE.md cites as raw data.
/results/
out/
tmp/
# Contact sheets are regenerated by bench/contact_sheet.py.
sheets/

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Local session scratch (added 2026-08-25) ---
# Things I move here rather than delete; never meant to be tracked.
_to_delete/
.claude/settings.local.json

# --- Benchmark payload and other archives ---
# bench_payload/ is the canonical frozen clip set (see docs/RUNBOOK_bench.md)
# but it is ~21 MB of encoded video. The frozen LIST lives in bench/clips.txt,
# which is tracked; the encodes are a build artifact and are not.
bench_payload/
*.zip

# --- Outgoing bundles (added 2026-09-02) ---
# _to_send/ is a packaged drop for the client: zips of things already tracked
# elsewhere in this repo. Regenerable, and ~32 MB.
_to_send/

# --- Extracted source frames (added 2026-09-02) ---
# bench_out/<clip>/frames/ is 1,080 JPEGs of the CLIENT'S source footage,
# extracted by load_frames() with ffmpeg and regenerable in seconds from the
# window clips. The persisted ALPHAS next to them stay tracked deliberately --
# two of this project's corrections came off those files with no GPU -- but the
# raw frames are the client's material and do not belong in version control.
bench/results/**/frames/

# --- Local admin (added 2026-09-07) ---
# Invoice and the copy of the 2 Sep client message. Not deliverables, not code.
_admin/

# --- Claude scratch outputs (added 2026-09-07) ---
# Evidence stills delivered into chat; the ones that matter are copied into
# _to_send/outputs/who_holds_what/ and into the vault.
Claude outputs/
