# --- Video / media inputs and outputs ---
clips/
output vids/
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.gif
*.wav
*.mp3

# --- Generated outputs ---
# Pipeline output at the repo root only. NOTE: intentionally anchored with a
# leading slash so it does NOT swallow bench/results/*.json, which are the
# small frozen baseline metrics that docs/BASELINE.md cites as raw data.
/results/
out/
tmp/
# Contact sheets are regenerated by bench/contact_sheet.py.
sheets/

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Local session scratch (added 2026-08-25) ---
# Things I move here rather than delete; never meant to be tracked.
_to_delete/
.claude/settings.local.json

# --- Benchmark payload and other archives ---
# bench_payload/ is the canonical frozen clip set (see docs/RUNBOOK_bench.md)
# but it is ~21 MB of encoded video. The frozen LIST lives in bench/clips.txt,
# which is tracked; the encodes are a build artifact and are not.
bench_payload/
*.zip
